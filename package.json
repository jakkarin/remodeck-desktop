{
  "name": "remodeck-desktop",
  "version": "0.1.0",
  "description": "Manage Git repositories and Docker on Windows and remote SSH hosts, with local GitHub credentials and push approvals.",
  "main": "./out/main/index.js",
  "author": "jakkarin",
  "license": "MIT",
  "homepage": "https://github.com/jakkarin/remodeck-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakkarin/remodeck-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/jakkarin/remodeck-desktop/issues"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "vitest run",
    "install:electron": "install-electron",
    "check:native": "node scripts/check-native.mjs",
    "postinstall": "node scripts/fix-node-pty-helper.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.54.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.1",
    "motion": "^14.1.0",
    "prettier": "^3.7.4",
    "radix-ui": "^1.7.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "^5.0.0"
    }
  }
}
